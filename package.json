{
  "name": "pi-coding-agent-vscode",
  "displayName": "Pi Code",
  "description": "VS Code client for the Pi coding agent: chat, tools, diffs, editor context, sessions",
  "version": "0.3.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piCode",
          "title": "Pi Code",
          "icon": "resources/pi-code.svg"
        }
      ]
    },
    "views": {
      "piCode": [
        {
          "id": "piCode.chatView",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "piCode.sessionsView",
          "name": "Sessions",
          "icon": "$(history)"
        }
      ]
    },
    "commands": [
      {
        "command": "piCode.newTask",
        "title": "New Task",
        "category": "Pi Code",
        "icon": "$(add)"
      },
      {
        "command": "piCode.stopTask",
        "title": "Stop Current Task",
        "category": "Pi Code",
        "icon": "$(debug-stop)"
      },
      {
        "command": "piCode.restartTask",
        "title": "Restart Current Task",
        "category": "Pi Code"
      },
      {
        "command": "piCode.addSelection",
        "title": "Add Selection to Pi Chat",
        "category": "Pi Code"
      },
      {
        "command": "piCode.addFile",
        "title": "Add File to Pi Chat",
        "category": "Pi Code"
      },
      {
        "command": "piCode.resumeSession",
        "title": "Resume Session…",
        "category": "Pi Code",
        "icon": "$(history)"
      },
      {
        "command": "piCode.newSession",
        "title": "New Session in Current Task",
        "category": "Pi Code"
      },
      {
        "command": "piCode.compact",
        "title": "Compact Context",
        "category": "Pi Code"
      },
      {
        "command": "piCode.rewind",
        "title": "Rewind Conversation",
        "category": "Pi Code",
        "icon": "$(discard)"
      },
      {
        "command": "piCode.focus",
        "title": "Focus Chat",
        "category": "Pi Code"
      },
      {
        "command": "piCode.openSession",
        "title": "Open Session",
        "category": "Pi Code",
        "icon": "$(go-to-file)"
      },
      {
        "command": "piCode.refreshSessions",
        "title": "Refresh Sessions",
        "category": "Pi Code",
        "icon": "$(refresh)"
      },
      {
        "command": "piCode.searchSessions",
        "title": "Search Sessions",
        "category": "Pi Code",
        "icon": "$(search)"
      },
      {
        "command": "piCode.toggleSessionScope",
        "title": "Toggle Workspace / All Sessions",
        "category": "Pi Code",
        "icon": "$(globe)"
      },
      {
        "command": "piCode.toggleArchived",
        "title": "Show / Hide Archived",
        "category": "Pi Code",
        "icon": "$(archive)"
      },
      {
        "command": "piCode.renameSession",
        "title": "Rename Session",
        "category": "Pi Code"
      },
      {
        "command": "piCode.archiveSession",
        "title": "Archive Session",
        "category": "Pi Code",
        "icon": "$(archive)"
      },
      {
        "command": "piCode.unarchiveSession",
        "title": "Unarchive Session",
        "category": "Pi Code"
      },
      {
        "command": "piCode.deleteSession",
        "title": "Delete Session",
        "category": "Pi Code",
        "icon": "$(trash)"
      },
      {
        "command": "piCode.revealSession",
        "title": "Reveal Session File",
        "category": "Pi Code"
      },
      {
        "command": "piCode.copySessionId",
        "title": "Copy Session Id",
        "category": "Pi Code"
      },
      {
        "command": "piCode.cycleEffort",
        "title": "Cycle Reasoning Effort",
        "category": "Pi Code"
      },
      {
        "command": "piCode.pickModel",
        "title": "Pick Model and Effort",
        "category": "Pi Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piCode.newTask",
          "when": "view == piCode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "piCode.stopTask",
          "when": "view == piCode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "piCode.newSession",
          "when": "view == piCode.sessionsView",
          "group": "navigation@1"
        },
        {
          "command": "piCode.searchSessions",
          "when": "view == piCode.sessionsView",
          "group": "navigation@2"
        },
        {
          "command": "piCode.toggleSessionScope",
          "when": "view == piCode.sessionsView",
          "group": "navigation@3"
        },
        {
          "command": "piCode.toggleArchived",
          "when": "view == piCode.sessionsView",
          "group": "navigation@4"
        },
        {
          "command": "piCode.refreshSessions",
          "when": "view == piCode.sessionsView",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "piCode.addSelection",
          "group": "piCode@1"
        }
      ],
      "explorer/context": [
        {
          "command": "piCode.addFile",
          "group": "piCode@1"
        }
      ],
      "view/item/context": [
        {
          "command": "piCode.openSession",
          "when": "view == piCode.sessionsView && viewItem =~ /^piSession/",
          "group": "inline@1"
        },
        {
          "command": "piCode.archiveSession",
          "when": "view == piCode.sessionsView && viewItem == piSession",
          "group": "inline@2"
        },
        {
          "command": "piCode.renameSession",
          "when": "view == piCode.sessionsView && viewItem =~ /^piSession/",
          "group": "1_edit@1"
        },
        {
          "command": "piCode.archiveSession",
          "when": "view == piCode.sessionsView && viewItem == piSession",
          "group": "1_edit@2"
        },
        {
          "command": "piCode.unarchiveSession",
          "when": "view == piCode.sessionsView && viewItem == piSessionArchived",
          "group": "1_edit@2"
        },
        {
          "command": "piCode.copySessionId",
          "when": "view == piCode.sessionsView && viewItem =~ /^piSession/",
          "group": "2_copy@1"
        },
        {
          "command": "piCode.revealSession",
          "when": "view == piCode.sessionsView && viewItem =~ /^piSession/",
          "group": "2_copy@2"
        },
        {
          "command": "piCode.deleteSession",
          "when": "view == piCode.sessionsView && viewItem =~ /^piSession/",
          "group": "3_danger@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piCode.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "piCode.focus",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "piCode.cycleEffort",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "Pi Code",
      "properties": {
        "piCode.piCommand": {
          "type": "string",
          "default": "",
          "description": "Pi executable. Leave empty to search PATH plus /usr/local/bin, /opt/homebrew/bin and nvm installs."
        },
        "piCode.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model passed to `pi --model` for new tasks, e.g. litellm/claude-opus-4-8. Empty uses pi's own default."
        },
        "piCode.defaultThinkingLevel": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "Thinking level applied to new sessions when the model supports it. Empty keeps pi's default."
        },
        "piCode.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI arguments for `pi --mode rpc`."
        },
        "piCode.sendOnEnter": {
          "type": "boolean",
          "default": true,
          "description": "Enter sends the message, Shift+Enter inserts a newline. When off, Ctrl/Cmd+Enter sends."
        },
        "piCode.restoreTasks": {
          "type": "boolean",
          "default": true,
          "description": "Reopen the tasks (and their pi sessions) from the last time the panel was used in this workspace."
        },
        "piCode.contextFileMaxKb": {
          "type": "number",
          "default": 96,
          "description": "Maximum size of a file inlined into the prompt via @mention or Add File."
        },
        "piCode.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show collapsible thinking blocks for models that stream reasoning."
        },
        "piCode.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "Reasoning effort for new tasks on gateways that encode effort in the model id (e.g. gpt-6-astra-xhigh). Empty keeps whatever the default model already says."
        },
        "piCode.preferFastVariants": {
          "type": "boolean",
          "default": false,
          "description": "Prefer the -fast variant of a model when switching family or effort."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "smoke": "npm run compile && node scripts/smoke.js",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "install-local": "npm run package && code --install-extension pi-coding-agent-vscode-0.3.0.vsix --force",
    "check": "npm run compile && node scripts/tiers-check.js && node scripts/webview-check.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/qagushaq/pi-coding-agent-vscode.git"
  },
  "license": "MIT"
}
