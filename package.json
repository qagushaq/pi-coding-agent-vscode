{
  "name": "pi-coding-agent-vscode",
  "displayName": "Pi Code",
  "description": "VS Code client for the Pi coding agent: chat, tools, diffs, editor context, sessions",
  "version": "0.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piCode",
          "title": "Pi Code",
          "icon": "resources/pi-code.svg"
        }
      ]
    },
    "views": {
      "piCode": [
        {
          "id": "piCode.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "piCode.newTask",
        "title": "New Task",
        "category": "Pi Code",
        "icon": "$(add)"
      },
      {
        "command": "piCode.stopTask",
        "title": "Stop Current Task",
        "category": "Pi Code",
        "icon": "$(debug-stop)"
      },
      {
        "command": "piCode.restartTask",
        "title": "Restart Current Task",
        "category": "Pi Code"
      },
      {
        "command": "piCode.addSelection",
        "title": "Add Selection to Pi Chat",
        "category": "Pi Code"
      },
      {
        "command": "piCode.addFile",
        "title": "Add File to Pi Chat",
        "category": "Pi Code"
      },
      {
        "command": "piCode.resumeSession",
        "title": "Resume Session…",
        "category": "Pi Code",
        "icon": "$(history)"
      },
      {
        "command": "piCode.newSession",
        "title": "New Session in Current Task",
        "category": "Pi Code"
      },
      {
        "command": "piCode.compact",
        "title": "Compact Context",
        "category": "Pi Code"
      },
      {
        "command": "piCode.focus",
        "title": "Focus Chat",
        "category": "Pi Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piCode.newTask",
          "when": "view == piCode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "piCode.resumeSession",
          "when": "view == piCode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "piCode.stopTask",
          "when": "view == piCode.chatView",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "piCode.addSelection",
          "group": "piCode@1"
        }
      ],
      "explorer/context": [
        {
          "command": "piCode.addFile",
          "group": "piCode@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piCode.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "piCode.focus",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "Pi Code",
      "properties": {
        "piCode.piCommand": {
          "type": "string",
          "default": "",
          "description": "Pi executable. Leave empty to search PATH plus /usr/local/bin, /opt/homebrew/bin and nvm installs."
        },
        "piCode.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model passed to `pi --model` for new tasks, e.g. litellm/claude-opus-4-8. Empty uses pi's own default."
        },
        "piCode.defaultThinkingLevel": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "description": "Thinking level applied to new sessions when the model supports it. Empty keeps pi's default."
        },
        "piCode.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra CLI arguments for `pi --mode rpc`."
        },
        "piCode.sendOnEnter": {
          "type": "boolean",
          "default": true,
          "description": "Enter sends the message, Shift+Enter inserts a newline. When off, Ctrl/Cmd+Enter sends."
        },
        "piCode.restoreTasks": {
          "type": "boolean",
          "default": true,
          "description": "Reopen the tasks (and their pi sessions) from the last time the panel was used in this workspace."
        },
        "piCode.contextFileMaxKb": {
          "type": "number",
          "default": 96,
          "description": "Maximum size of a file inlined into the prompt via @mention or Add File."
        },
        "piCode.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show collapsible thinking blocks for models that stream reasoning."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "smoke": "npm run compile && node scripts/smoke.js",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "install-local": "npm run package && code --install-extension pi-coding-agent-vscode-0.2.0.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/qagushaq/pi-coding-agent-vscode.git"
  },
  "license": "MIT"
}
